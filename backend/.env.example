DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# Direct (non-pooler) PostgreSQL URL used by pg_dump.
BACKUP_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# Keep the seven newest successful local dumps.
BACKUP_RETENTION_COUNT="7"
# Optional rclone directory, for example: s3:jkr-backups/production
OFFSITE_BACKUP_TARGET=""
OPENAI_API_KEY="replace-with-your-openai-api-key"
OPENAI_MODEL="gpt-4.1-mini"
JWT_SECRET="replace-with-a-long-random-secret"
REFRESH_SECRET="replace-with-a-different-long-random-secret"
FRONTEND_URL="http://localhost:5173"
