generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(20)
  users     User[]

  @@map("roles")
}

model User {
  user_id         Int             @id @default(autoincrement())
  user_name       String          @db.VarChar(25)
  user_profile    String?
  role_id         Int
  bio             String?         @db.VarChar(100)
  gender          String?         @db.VarChar(10)
  dob             DateTime?       @db.Date
  status          String?         @default("active") @db.VarChar(10)
  favorites       Favorite[]
  histories       History[]
  logs_audit      Logs_audit[]
  createdRecipes  Recipe[]
  refreshTokens   RefreshToken[]
  suggestions     Suggestion[]
  user_ai_cooking UserAICooking[]
  auth            UserAuth?
  role            Role            @relation(fields: [role_id], references: [role_id])

  @@map("users")
}

model UserAuth {
  email         String   @unique @db.VarChar(40)
  password_hash String   @db.VarChar(100)
  created_at    DateTime @default(now())
  user_id       Int      @id
  user          User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_auth")
}

model Ingredient {
  ingredient_id     Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(20)
  calories_per_100g Int?
  carbs_per_100g    Float?
  fat_per_100g      Float?
  protein_per_100g  Float?
  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

model Recipe {
  recipe_id            Int                 @id @default(autoincrement())
  title                String              @db.VarChar(30)
  description          String?
  difficulty           Difficulty
  cook_time            Int                 @default(0)
  created_by           Int
  servings             Int
  image_url            String?
  prep_time            Int                 @default(0)
  view_count           Int                 @default(0)
  created_at           DateTime            @default(now())
  updated_at           DateTime            @default(now()) @updatedAt
  deleted_at           DateTime?
  ai_generated_recipes AIGeneratedRecipe[]
  favorites            Favorite[]
  histories            History[]
  logs                 Logs_audit[]
  recipeIngredients    RecipeIngredient[]
  steps                RecipeStep[]
  creator              User                @relation(fields: [created_by], references: [user_id])
  suggestions          Suggestion[]

  @@map("recipes")
}

model RecipeIngredient {
  recipe_id     Int
  ingredient_id Int
  quantity      Decimal    @db.Decimal(10, 2)
  unit          String     @db.VarChar(15)
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [ingredient_id])
  recipe        Recipe     @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade)

  @@unique([recipe_id, ingredient_id])
  @@map("recipe_ingredients")
}

model RecipeStep {
  step_id          Int      @id @default(autoincrement())
  recipe_id        Int
  step_number      Int
  instruction_text String
  created_at       DateTime @default(now())
  recipe           Recipe   @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade)

  @@unique([recipe_id, step_number])
  @@map("recipe_steps")
}

model Favorite {
  favorite_id Int      @id @default(autoincrement())
  user_id     Int
  recipe_id   Int
  created_at  DateTime @default(now())
  recipe      Recipe   @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, recipe_id])
  @@map("favorites")
}

model History {
  history_id Int      @id @default(autoincrement())
  user_id    Int
  recipe_id  Int
  cooked_at  DateTime @default(now())
  recipe     Recipe   @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("history")
}

model Suggestion {
  suggestion_id   Int              @id @default(autoincrement())
  user_id         Int
  recipe_id       Int
  suggestion_text String
  status          SuggestionStatus @default(pending)
  created_at      DateTime         @default(now())
  deleted_at      DateTime?
  logs            Logs_audit[]
  recipe          Recipe           @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade)
  user            User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("suggestions")
}

model Logs_audit {
  audit_id         Int             @id @default(autoincrement())
  user_id          Int
  recipe_id        Int?
  action_type      AdminActionType
  action_timestamp DateTime        @default(now())
  suggestion_id    Int?
  users            User            @relation(fields: [user_id], references: [user_id], map: "logs_audit_admin_id_fkey")
  recipe           Recipe?         @relation(fields: [recipe_id], references: [recipe_id])
  suggestion       Suggestion?     @relation(fields: [suggestion_id], references: [suggestion_id])

  @@index([suggestion_id])
  @@map("logs_audit")
}

model RefreshToken {
  token_id   Int       @id @default(autoincrement())
  token      String    @unique
  user_id    Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  expires_at DateTime  @db.Timestamp(6)
  user       User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model AIGeneratedRecipe {
  ai_recipe_id       Int             @id @default(autoincrement())
  title              String          @db.VarChar(255)
  description        String?
  image_url          String?
  ingredients        Json
  steps              Json
  generated_by       String?         @default("OpenAI") @db.VarChar(50)
  status             String?         @default("pending") @db.VarChar(20)
  approved_recipe_id Int?
  created_at         DateTime?       @default(now()) @db.Timestamp(6)
  recipes            Recipe?         @relation(fields: [approved_recipe_id], references: [recipe_id], onUpdate: NoAction, map: "fk_approved_recipe")
  user_ai_cooking    UserAICooking[]

  @@map("ai_generated_recipes")
}

model UserAICooking {
  id                   Int               @id @default(autoincrement())
  user_id              Int
  ai_recipe_id         Int
  ingredient_key       String
  action               ai_action
  created_at           DateTime?         @default(now()) @db.Timestamp(6)
  ai_generated_recipes AIGeneratedRecipe @relation(fields: [ai_recipe_id], references: [ai_recipe_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_recipe")
  users                User              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@index([ingredient_key], map: "idx_user_ai_cooking_ingredient_key")
  @@index([user_id, ingredient_key], map: "idx_user_ai_cooking_user_ingredient")
  @@map("user_ai_cooking")
}

enum Difficulty {
  easy
  medium
  hard
}

enum SuggestionStatus {
  pending
  accepted
  rejected
}

enum AdminActionType {
  create
  update
  delete
  approve
  reject
}

enum ai_action {
  cook
  skip
}


